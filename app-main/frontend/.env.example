# Frontend environment variables
# On Railway: set EXPO_PUBLIC_BACKEND_URL in the Dashboard > Variables
# Locally: copy this to .env and set your backend URL

EXPO_TUNNEL_SUBDOMAIN=order-kitchen-hub
EXPO_USE_FAST_RESOLVER=1
METRO_CACHE_ROOT=/tmp/.metro-cache
EXPO_NO_INTERACTIVE_CLI=true

# Backend URL (must start with EXPO_PUBLIC_ to be available in Expo)
EXPO_PUBLIC_BACKEND_URL=https://your-railway-backend.up.railway.app
