# Backend environment variables
# On Railway: set these in the Dashboard > Variables
# Locally: copy this to .env and fill in values

MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0
DB_NAME=database_name
ADMIN_PASSWORD=your_admin_password
MASTER_PASSWORD=your_master_password
CHEF_PASSWORD=your_chef_password

# For payment checkout page
PUBLIC_BACKEND_URL=https://your-railway-app.up.railway.app

# Railway sets this automatically in production
# RAILWAY_ENVIRONMENT=true
